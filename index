 return "";
}

function renderBoard(filter=""){
 const board=qs("#board"); board.innerHTML="";
 ["start","progress","done"].forEach(status=>{
   let items=projects.filter(p=>p.status===status && p.title.toLowerCase().includes(filter.toLowerCase()));
   const col=document.createElement("div"); col.className="column"; col.dataset.status=status;
   col.innerHTML=`<div class="column-head"><span class="status-pill ${statusMeta[status].cls}">${statusMeta[status].label}</span><span class="count">${items.length}</span><button class="column-add" type="button" title="${statusMeta[status].label} 프로젝트 추가">＋</button></div><div class="cards"></div>`;
   col.querySelector(".column-add").onclick=e=>{e.stopPropagation();openNew(status)};
   const cards=col.querySelector(".cards");
   if(!items.length) cards.innerHTML=`<div class="empty">여기에 프로젝트를 놓으세요.</div>`;
   items.forEach(p=>{
     const el=document.createElement("article"); el.className="card"; el.draggable=true; el.dataset.id=p.id;
     const boardTags=(p.actualTags?.length?p.actualTags.map(t=>typeof t==="string"?t:t.name):(p.tags||[]));
     const visibleTags=boardTags.slice(0,2);
     const extra=boardTags.length-visibleTags.length;
     const metaText = visibleTags.join(" · ") + (extra>0?` +${extra}`:"");
     el.innerHTML=`<div class="card-title" title="${attr(p.title)}">${escapeHtml(p.title)}</div>${metaText?`<div class="tags-plain" title="${attr(boardTags.join(" · "))}">${escapeHtml(metaText)}</div>`:""}`;
     el.onclick=()=>openDetail(p.id);
     el.addEventListener("dragstart",()=>el.classList.add("dragging"));
     el.addEventListener("dragend",()=>el.classList.remove("dragging"));
     cards.appendChild(el);
   });
   col.addEventListener("dragover",e=>{e.preventDefault();col.classList.add("drop-hint")});
   col.addEventListener("dragleave",()=>col.classList.remove("drop-hint"));
   col.addEventListener("drop",e=>{
     e.preventDefault();col.classList.remove("drop-hint");
     const drag=qs(".card.dragging"); if(!drag)return;
     const p=projects.find(x=>x.id==drag.dataset.id); p.status=status;persist();renderBoard(qs("#searchInput").value);toast(`${statusMeta[status].label}로 이동`);
   });
   board.appendChild(col);
 });
}

