function dateKeyCal(d){
 const p=n=>String(n).padStart(2,"0");
 return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`;
}
function parseCalDate(s){
 const [y,m,d]=String(s).split("-").map(Number);
 return new Date(y,m-1,d,12,0,0,0);
}
function addCalDays(d,n){
 const x=new Date(d);x.setDate(x.getDate()+n);return x;
}
function maxCalDate(a,b){return a>b?a:b}
function minCalDate(a,b){return a<b?a:b}
function presetForEvent(ev){
 return calendarPresets.find(p=>p.id===ev.presetId) || calendarPresets[0] || calendarPresetDefaults[0];
}
function calendarBarStyle(p){
 if(p.style==="outline")return `background:transparent;color:${p.bg};border:1px solid ${p.bg};`;
 if(p.style==="soft")return `background:color-mix(in srgb,${p.bg} 30%,#1a1c1a);color:${p.text};border:1px solid color-mix(in srgb,${p.bg} 55%,#2b2e2b);`;
 return `background:${p.bg};color:${p.text};border:1px solid color-mix(in srgb,${p.bg} 78%,#222);`;
}
function monthWeeksCal(year,month){
 const first=new Date(year,month-1,1,12);
 const last=new Date(year,month,0,12);
 const start=addCalDays(first,-first.getDay());
 const end=addCalDays(last,6-last.getDay());
 const weeks=[];
 for(let cur=start;cur<=end;cur=addCalDays(cur,7)){
   weeks.push(Array.from({length:7},(_,i)=>addCalDays(cur,i)));
 }
 return weeks;
}
function assignCalendarLanes(segments){
 const lanes=[];
 return segments.map(seg=>{
   let lane=0;
   while(lanes[lane] && !(seg.startCol>lanes[lane].endCol || seg.endCol<lanes[lane].startCol))lane++;
   lanes[lane]={startCol:seg.startCol,endCol:seg.endCol};
   return {...seg,lane};
 });
}

function calendarMonthKey(){
 return `${calendarYear}-${String(calendarMonth).padStart(2,"0")}`;
}
function todoVisibleInMonth(todo,monthKey){
 if(todo.repeat==="monthly")return monthKey>=String(todo.month||monthKey);
 return String(todo.month||"")===monthKey;
}
function todoDoneForMonth(todo,monthKey){
 return todo.repeat==="monthly" ? !!(todo.doneMonths||{})[monthKey] : !!todo.done;
}
function todoItemDoneForMonth(todo,item,monthKey){
 return todo.repeat==="monthly" ? !!(item.doneMonths||{})[monthKey] : !!item.done;
}
function todoDueDateForMonth(todo,monthKey){
 if(!todo.due)return null;
 if(todo.repeat==="monthly"){
   const day=Number(String(todo.due).slice(-2));
   const [y,m]=monthKey.split("-").map(Number);
   const lastDay=new Date(y,m,0,12).getDate();
   return new Date(y,m-1,Math.min(day,lastDay),12);
 }
 return parseCalDate(todo.due);
}
function todoDdayInfo(todo,monthKey){
 const target=todoDueDateForMonth(todo,monthKey);
 if(!target)return {label:"",diff:null};
 const now=new Date();
 const today=new Date(now.getFullYear(),now.getMonth(),now.getDate(),12);
 const diff=Math.round((target-today)/86400000);
 let label="";
 if(diff>0)label=`D-${diff}`;
 else if(diff===0)label="D-DAY";
 else label=`D+${Math.abs(diff)}`;
 return {label,diff};
}
