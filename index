  if(/^###\s/.test(line))return `<h3>${renderInlineV5(line.replace(/^###\s/,""))}</h3>`;
  if(/^##\s/.test(line))return `<h2>${renderInlineV5(line.replace(/^##\s/,""))}</h2>`;
  if(/^#\s/.test(line))return `<h1>${renderInlineV5(line.replace(/^#\s/,""))}</h1>`;
  if(/^>\s?/.test(line))return `<blockquote>${renderInlineV5(line.replace(/^>\s?/,""))}</blockquote>`;
  if(/^-\s/.test(line))return `<ul><li>${renderInlineV5(line.replace(/^-\s/,""))}</li></ul>`;
  return `<div>${renderInlineV5(line)}</div>`;
}
function renderInlineV5(s){
  let e=escapeHtml(s);
  const stash=[],put=(html)=>{const k=`@@PV${stash.length}@@`;stash.push(html);return k};
  e=e.replace(/\{\{user\}\}/gi,m=>put(`<span class="preview-user">${m}</span>`));
  e=e.replace(/\{\{char\}\}/gi,m=>put(`<span class="preview-char">${m}</span>`));
  e=e.replace(/\{\{([^{}]+)\}\}/g,(m,v)=>put(`<span class="preview-var">{{${v}}}</span>`));
  e=e.replace(/\*\*([^*]+)\*\*/g,"<strong>$1</strong>");
  e=e.replace(/\*([^*]+)\*/g,"<em>$1</em>");
  e=e.replace(/\[([^\]]+)\]/g,'<span style="color:#e18cb8">[$1]</span>');
  e=e.replace(/\|([^|]+)\|/g,'<span style="color:#dea36b">|$1|</span>');
  e=e.replace(/(https?:\/\/[^\s<]+)/g,'<a class="preview-url" target="_blank" rel="noopener" href="$1">$1</a>');
  stash.forEach((v,i)=>e=e.replace(`@@PV${i}@@`,v));
  return e;
}

function openDetail(id){
  pendingNewProject=false;
  pendingIdeaId=null;currentId=Number(id);
  const p=projects.find(x=>x.id===currentId);if(!p)return;
  normalizeProjectV5(p);editorDraft=cloneV5(p);
  renderEditorV5("edit");qs("#drawer").classList.add("open");qs("#drawerBack").classList.add("open");
}
function openIdeaAsProject(id){
  const idea=ideas.find(i=>i.id===id);if(!idea)return;
  pendingNewProject=false;
  pendingIdeaId=id;currentId=null;const now=stampNow();
  editorDraft=normalizeProjectV5({
    id:null,title:idea.title,status:"start",createdAt:now,updatedAt:now,
    genreTags:[],actualTags:[],platformTags:[],assetFolder:"",mainImages:[],bodyImages:[],
    content:idea.note||"",summary:idea.note||""
  });
  renderEditorV5("idea");qs("#drawer").classList.add("open");qs("#drawerBack").classList.add("open");
}
function saveDetail(){
  if(!editorDraft)return;
  editorDraft.title=(qs("#dTitle")?.value||editorDraft.title||"").trim()||"제목 없음";
  const chosenStatus=qs("#dStatus")?.value||"";
  if(!chosenStatus){
    toast("상태를 먼저 지정해줘");
    const props=qs("#projectProps");if(props)props.open=true;
    setTimeout(()=>qs("#dStatus")?.focus(),30);
    return;
  }
  editorDraft.status=chosenStatus;
  if(qs("#docInput"))editorDraft.content=qs("#docInput").value;
  editorDraft.updatedAt=stampNow();
  editorDraft.bodyImages=editorDraft.bodyImages||[];
  editorDraft.tags=selectedTagNames(editorDraft);
  editorDraft.platform=(editorDraft.platformTags||[]).map(t=>t.name).join(", ");
  editorDraft.date=(editorDraft.createdAt||"").slice(0,10);
  saveTagCatalogs();

  if(pendingNewProject){
    editorDraft.id=Date.now();
    projects.unshift(cloneV5(editorDraft));
    currentId=editorDraft.id;
    pendingNewProject=false;
    persist();
    renderBoard(qs("#searchInput").value);
    toast("프로젝트 저장됨");
    openDetail(currentId);
    return;
  }

  if(pendingIdeaId!==null){
    editorDraft.id=Date.now();projects.unshift(cloneV5(editorDraft));
    ideas=ideas.filter(i=>i.id!==pendingIdeaId);currentId=editorDraft.id;pendingIdeaId=null;
    persist();renderIdeas();renderBoard();toast("프로젝트로 저장됨");openDetail(currentId);return;
  }
  const idx=projects.findIndex(p=>p.id===currentId);if(idx<0)return;
  projects[idx]=cloneV5(editorDraft);persist();renderBoard(qs("#searchInput").value);toast("저장됨");
  renderEditorV5("edit");
}
