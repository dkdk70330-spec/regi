<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>작업실 Prototype</title>
<style>
  :root{
    --bg:#141514; --panel:#1b1c1b; --panel2:#202220; --line:#303330;
    --text:#f4f4f1; --muted:#969b95; --soft:#c8cbc6;
    --amber:#b68b2b; --amber-bg:#3b3422;
    --blue:#3f8ed7; --blue-bg:#223447;
    --green:#4ea673; --green-bg:#20372a;
    --gray:#9a9a94; --gray-bg:#252625;
    --danger:#d76b6b; --shadow:0 18px 60px rgba(0,0,0,.34);
    --radius:16px; --radius-sm:11px;
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,Pretendard,"Noto Sans KR",system-ui,sans-serif}
  body{min-height:100vh;overflow-x:hidden}
  button,input,textarea,select{font:inherit}
  button{color:inherit}
  a{color:inherit;text-decoration:none}
  .app{display:grid;grid-template-columns:220px minmax(0,1fr);min-height:100vh}
  .sidebar{
    position:sticky;top:0;height:100vh;padding:20px 14px;border-right:1px solid var(--line);
    background:#111211;display:flex;flex-direction:column;gap:18px;z-index:10
  }
  .brand{display:flex;align-items:center;gap:11px;padding:8px 10px;font-weight:800;font-size:18px}
  .brand-mark{width:30px;height:30px;border-radius:10px;background:linear-gradient(145deg,#d8c06c,#6d8f55);display:grid;place-items:center;color:#111}
  .nav{display:grid;gap:6px}
  .nav button,.side-action{
    border:0;background:transparent;text-align:left;padding:10px 12px;border-radius:10px;cursor:pointer;color:var(--soft)
  }
  .nav button:hover,.side-action:hover{background:#202220;color:white}
  .nav button.active{background:#272927;color:white}
  .nav .icon{display:inline-block;width:26px;color:#a8ada7}
  .side-meta{margin-top:auto;display:grid;gap:8px}
  .sync-card{border:1px solid var(--line);border-radius:12px;padding:11px;background:#171817}
  .sync-title{font-size:12px;color:var(--muted);margin-bottom:7px}
  .sync-row{display:flex;justify-content:space-between;align-items:center;font-size:13px}
  .dot{width:8px;height:8px;border-radius:50%;background:#d1a448;box-shadow:0 0 0 4px rgba(209,164,72,.08)}
  .main{min-width:0}
  .topbar{
    position:sticky;top:0;z-index:8;height:68px;display:flex;align-items:center;gap:10px;
    padding:0 26px;border-bottom:1px solid rgba(48,51,48,.72);background:rgba(20,21,20,.92);backdrop-filter:blur(16px)
  }
  .title-wrap{margin-right:auto}
  .eyebrow{font-size:11px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}
  .page-title{font-weight:800;font-size:20px;margin-top:2px}
  .tool{
    border:1px solid var(--line);background:#1b1c1b;border-radius:10px;padding:9px 11px;cursor:pointer
  }
  .tool:hover{border-color:#454a45;background:#212321}
  .primary{background:#2c79be;border-color:#2c79be}
  .primary:hover{background:#3688cf;border-color:#3688cf}
  .search{position:relative}
  .search input{
    width:220px;background:#191a19;border:1px solid var(--line);border-radius:10px;color:var(--text);padding:9px 12px 9px 34px;outline:none
  }
  .search input:focus{border-color:#505650}
  .search:before{content:"⌕";position:absolute;left:11px;top:7px;color:#8e948e;font-size:18px}
  .content{padding:26px;max-width:1800px;margin:0 auto}
  .view{display:none}
  .view.active{display:block}
  .section-head{display:flex;align-items:flex-end;gap:12px;margin-bottom:18px}
  .section-head h1{font-size:28px;margin:0}
  .section-head p{margin:0 0 3px;color:var(--muted);font-size:13px}
  .board{
    display:grid;grid-template-columns:repeat(3,minmax(280px,1fr));gap:12px;align-items:stretch
  }
  .column{
    background:#171817;border:1px solid #292c29;border-radius:12px;
    height:calc(100vh - 190px);min-height:540px;overflow:hidden;
    display:flex;flex-direction:column
  }
  .column-head{padding:14px 14px 10px;display:flex;align-items:center;gap:8px;position:sticky;top:68px;background:#171817;z-index:2}
  .status-pill{font-size:12px;font-weight:700;border-radius:999px;padding:5px 9px;display:inline-flex;gap:6px;align-items:center}
  .status-pill:before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
  .status-start{color:#aaa;background:#2a2b2a}
  .status-progress{color:#4b9ee8;background:#21364b}
  .status-done{color:#5bbb7d;background:#213a2b}
  .count{font-size:12px;color:var(--muted)}
  .cards{
    padding:0 12px 12px;display:block;min-height:0;flex:1;overflow:auto
  }
  .card{
    background:transparent;border:0;border-top:1px solid #2a2d2a;border-radius:0;
    padding:10px 3px;cursor:pointer;display:flex;align-items:center;gap:12px;min-width:0
  }
  .card:first-child{border-top:0}
  .card:hover{background:#1d1f1d}
  .card.dragging{opacity:.42}
  .card-title{
    font-size:13px;font-weight:700;line-height:1.35;min-width:0;flex:1;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis
  }
  .tags-plain{
    max-width:45%;flex:0 1 auto;color:#7f857f;font-size:10px;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis;text-align:right
  }
  .drop-hint{outline:1px dashed #536153;outline-offset:-5px;background:#1a201b}
  .empty{padding:30px 10px;text-align:center;color:#737873;font-size:13px}


  .idea-capture{
    display:flex;align-items:center;gap:10px;background:#1b1d1b;border:1px solid #343734;border-radius:14px;
    padding:10px 12px;margin-bottom:14px
  }
  .idea-capture .bulb{font-size:20px}
  .idea-capture textarea{
    flex:1;min-width:0;min-height:84px;background:transparent;border:0;outline:none;color:white;
    padding:8px 2px;font-size:14px;line-height:1.6;resize:vertical
  }
  .idea-capture .idea-save{align-self:flex-end}
  .idea-list{display:grid;gap:7px}
  .idea-row{
    display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;
    background:#1b1d1b;border:1px solid var(--line);border-radius:11px;padding:10px 11px
  }
  .idea-main{min-width:0;display:flex;align-items:center;gap:10px}
  .idea-title{font-size:13px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .idea-note{font-size:11px;color:#858b85;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .idea-actions{display:flex;gap:6px;align-items:center}
  .idea-project{
    border:1px solid #3b493f;background:#223028;color:#cfe9d7;border-radius:8px;padding:6px 9px;
    cursor:pointer;font-size:11px;white-space:nowrap
  }
  .idea-project:hover{background:#294033}
  .idea-delete{
    border:0;background:transparent;color:#717771;cursor:pointer;padding:5px 7px;border-radius:7px
  }
  .idea-delete:hover{background:#292b29;color:#d0d4cf}
  .idea-empty{border:1px dashed #333733;border-radius:12px;padding:28px;text-align:center;color:#747a74;font-size:13px}
  .quick-idea{
    position:fixed;right:24px;bottom:24px;z-index:24;width:52px;height:52px;border-radius:17px;
    border:1px solid #65572d;background:#d0a943;color:#19170f;font-size:21px;cursor:pointer;
    box-shadow:0 14px 36px rgba(0,0,0,.35);display:grid;place-items:center
  }
  .quick-idea:hover{transform:translateY(-1px);background:#ddb74e}
  .quick-modal{width:min(480px,100%)}
  .quick-input{
    width:100%;min-height:150px;background:#131413;border:1px solid #393d39;border-radius:11px;color:#fff;
    padding:13px 14px;font-size:15px;line-height:1.65;outline:none;resize:vertical
  }
  .quick-input:focus{border-color:#75652f}
  .quick-hint{font-size:11px;color:#747a74;margin-top:9px}

  .calendar-shell{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#171817}
  .cal-head{display:flex;align-items:center;justify-content:space-between;padding:15px 16px;border-bottom:1px solid var(--line)}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr)}
  .dow{padding:10px;text-align:center;color:#7f857f;font-size:11px;border-bottom:1px solid var(--line)}
  .day{min-height:126px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:8px;position:relative}
  .day:nth-child(7n){border-right:0}.date-num{font-size:12px;color:#cfd2ce;margin-bottom:7px}
  .date-num.muted{color:#626662}
  .event{font-size:11px;font-weight:700;padding:5px 6px;border-radius:6px;margin-bottom:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .event.amber{background:#5d4e25}.event.green{background:#254532}.event.gray{background:#363836}

  .gallery{display:grid;grid-template-columns:repeat(5,minmax(140px,1fr));gap:14px}
  .asset{background:#1b1d1b;border:1px solid var(--line);border-radius:14px;overflow:hidden;cursor:pointer}
  .thumb{
    aspect-ratio:1.35/1;background:
      radial-gradient(circle at 30% 25%,rgba(255,255,255,.16),transparent 25%),
      linear-gradient(145deg,var(--a,#303a35),var(--b,#151615));
    display:grid;place-items:center;font-size:46px;position:relative;overflow:hidden
  }
  .thumb:after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.18),transparent 50%)}
  .asset-name{padding:10px 12px;font-size:13px;font-weight:700}

  .library-grid{display:grid;grid-template-columns:repeat(3,minmax(240px,1fr));gap:14px}
  .lib-card{padding:18px;background:#1b1d1b;border:1px solid var(--line);border-radius:14px}
  .lib-icon{font-size:24px;margin-bottom:14px}.lib-card h3{margin:0 0 8px}.lib-card p{color:var(--muted);font-size:13px;line-height:1.6;margin:0}
  .lib-count{margin-top:15px;color:#c6cac5;font-size:12px}

  .drawer-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.48);z-index:30;opacity:0;pointer-events:none;transition:.2s}
  .drawer-backdrop.open{opacity:1;pointer-events:auto}
  .drawer{
    position:fixed;right:0;top:0;bottom:0;width:min(940px,96vw);background:#171817;border-left:1px solid #353935;z-index:31;
    transform:translateX(100%);transition:.24s ease;box-shadow:var(--shadow);overflow:auto
  }
  .drawer.open{transform:none}
  .drawer-top{position:sticky;top:0;z-index:2;display:flex;justify-content:flex-end;gap:8px;padding:12px;background:rgba(26,27,26,.94);backdrop-filter:blur(14px);border-bottom:1px solid rgba(48,51,48,.75)}
  .icon-btn{border:0;background:#262826;border-radius:9px;padding:8px 10px;cursor:pointer}
  .detail{padding:30px 44px 60px}
  .detail h1{font-size:34px;margin:4px 0 8px}
  .detail-sub{color:#8d928d;font-size:13px;margin-bottom:26px}
  .meta{display:grid;grid-template-columns:110px 1fr;gap:13px 16px;padding:18px 0 24px;border-bottom:1px solid var(--line);font-size:13px}
  .meta-label{color:#858b85}
  .preview-card{margin:28px 0 18px;border:1px solid #363a36;border-radius:12px;overflow:hidden;display:grid;grid-template-columns:1fr 210px;background:#1e201e}
  .preview-text{padding:16px}.preview-text strong{display:block;margin-bottom:7px}.preview-text p{color:#a9aea8;margin:0 0 10px;font-size:12px;line-height:1.55}
  .preview-img{background:linear-gradient(145deg,#5d4a30,#171b18);display:grid;place-items:center;font-size:60px}
  details{border-bottom:1px solid #2f322f;padding:12px 0}
  summary{cursor:pointer;font-weight:800;padding:4px 0;list-style:none}
  summary::-webkit-details-marker{display:none}
  summary:before{content:"▸";display:inline-block;width:20px;color:#c7cbc6}
  details[open] summary:before{content:"▾"}
  .detail-body{padding:12px 20px 6px;color:#c6cac5;line-height:1.75;font-size:13px}
  .codebox{background:#202220;border:1px solid #2d302d;border-radius:10px;padding:14px;white-space:pre-wrap;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;color:#d9ddd8}
  .edit-title{width:100%;font-size:34px;font-weight:800;color:white;background:transparent;border:0;outline:none;padding:0}
  .editable{width:100%;min-height:150px;background:#202220;border:1px solid #303330;border-radius:10px;color:#e6e8e4;padding:12px;resize:vertical;outline:none;line-height:1.7}
  .modal-back{position:fixed;inset:0;background:rgba(0,0,0,.56);z-index:50;display:none;align-items:center;justify-content:center;padding:20px}
  .modal-back.open{display:flex}
  .modal{width:min(540px,100%);background:#1b1d1b;border:1px solid #383b38;border-radius:16px;box-shadow:var(--shadow);padding:22px}
  .modal h2{margin:0 0 18px}
  .field{display:grid;gap:7px;margin-bottom:14px}.field label{font-size:12px;color:#9ba09a}
  .field input,.field select,.field textarea{width:100%;background:#141514;border:1px solid #343734;border-radius:9px;padding:10px 11px;color:white;outline:none}
  .modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}
  .toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,20px);background:#f1f2ef;color:#171817;padding:10px 14px;border-radius:10px;font-size:13px;opacity:0;pointer-events:none;transition:.2s;z-index:80}
  .toast.show{opacity:1;transform:translate(-50%,0)}
  .mobile-nav{display:none}
  .hint{color:#777d77;font-size:12px;margin-top:10px}

  @media(max-width:1100px){
    .app{grid-template-columns:76px minmax(0,1fr)}
    .brand span:last-child,.nav .label,.side-meta .sync-card,.side-action .label{display:none}
    .sidebar{align-items:center;padding-inline:10px}
    .nav button,.side-action{width:50px;text-align:center;padding:10px}
    .nav .icon{width:auto}
    .gallery{grid-template-columns:repeat(4,minmax(120px,1fr))}
    .library-grid{grid-template-columns:repeat(2,minmax(220px,1fr))}
  }
  @media(max-width:760px){
    body{padding-bottom:70px}
    .app{display:block}
    .sidebar{display:none}
    .topbar{height:auto;min-height:62px;padding:10px 14px;flex-wrap:wrap;gap:8px}
    .title-wrap{width:100%;order:-2}
    .search{flex:1}.search input{width:100%}
    .content{padding:16px 12px 24px}
    .section-head h1{font-size:24px}
    .board{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px}
    .column{min-width:86vw;scroll-snap-align:start;height:calc(100vh - 225px);min-height:480px}
    .column-head{top:106px}
    .gallery{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .library-grid{grid-template-columns:1fr}
    .calendar-shell{overflow-x:auto}.cal-grid{min-width:820px}
    .drawer{width:100vw}.detail{padding:22px 18px 50px}.detail h1,.edit-title{font-size:27px}
    .preview-card{grid-template-columns:1fr}.preview-img{min-height:140px}
    .idea-row{grid-template-columns:minmax(0,1fr) auto}
    .idea-note{display:none}
    .quick-idea{right:14px;bottom:78px;width:48px;height:48px;border-radius:15px}
    .mobile-nav{
      position:fixed;left:0;right:0;bottom:0;height:64px;background:rgba(17,18,17,.96);backdrop-filter:blur(16px);
      border-top:1px solid var(--line);z-index:20;display:grid;grid-template-columns:repeat(5,1fr)
    }
    .mobile-nav button{border:0;background:transparent;color:#949994;font-size:10px;display:grid;place-items:center;gap:2px;padding:7px}
    .mobile-nav button.active{color:white}
    .mobile-nav b{font-size:18px;font-weight:500}
  }

  /* v5 project editor */
  .detail{padding:32px 42px 72px}
  .project-head{margin-bottom:22px}
  .project-head small{display:block;color:#707670;font-size:10px;letter-spacing:.08em;margin-bottom:7px}
  .edit-title{width:100%;font-size:34px;font-weight:820;letter-spacing:-.02em;color:#fff;background:transparent;border:0;outline:none;padding:0}
  .detail-sub{color:#7c827c;font-size:12px;margin-top:6px}

  .project-props{
    display:grid;grid-template-columns:130px minmax(0,1fr);gap:8px 16px;
    border-top:1px solid #2d302d;border-bottom:1px solid #2d302d;padding:16px 0 18px;margin-bottom:22px
  }
  .prop-label{color:#777d77;font-size:12px;padding-top:8px}
  .prop-value{min-width:0;position:relative}
  .prop-readonly{padding:7px 0;color:#c7cbc6;font-size:12px}
  .status-select{
    background:#202220;border:1px solid #343834;color:#f0f2ef;border-radius:8px;padding:7px 9px;outline:none
  }

  .tag-property{
    min-height:38px;border:1px solid transparent;border-radius:9px;padding:4px 5px;
    display:flex;align-items:center;gap:5px;flex-wrap:wrap;position:relative
  }
  .tag-property:hover{border-color:#2e322e;background:#1b1d1b}
  .prop-tag{
    display:inline-flex;align-items:center;gap:5px;padding:4px 7px;border-radius:6px;
    background:color-mix(in srgb,var(--tag) 28%,#232423);color:#f4f5f2;font-size:11px;font-weight:700;
    border:1px solid color-mix(in srgb,var(--tag) 48%,#333)
  }
  .prop-tag i{width:6px;height:6px;border-radius:50%;background:var(--tag)}
  .prop-tag button{border:0;background:transparent;color:#b5bab4;cursor:pointer;padding:0 0 0 2px}
  .tag-open{
    width:28px;height:28px;border:0;background:transparent;border-radius:7px;color:#7d837d;cursor:pointer
  }
  .tag-open:hover{background:#262926;color:#fff}

  .property-menu{
    position:absolute;left:0;top:calc(100% + 6px);width:min(330px,90vw);z-index:15;
    background:#242624;border:1px solid #3a3e3a;border-radius:11px;box-shadow:0 16px 45px rgba(0,0,0,.42);
    padding:8px;display:none
  }
  .property-menu.open{display:block}
  .property-menu input{
    width:100%;background:#1b1d1b;border:1px solid #393d39;border-radius:8px;color:#fff;padding:8px 9px;outline:none;margin-bottom:7px
  }
  .menu-caption{font-size:10px;color:#757b75;padding:5px 6px}
  .tag-option{
    display:flex;align-items:center;gap:8px;padding:7px 7px;border-radius:7px;cursor:pointer;font-size:12px
  }
  .tag-option:hover{background:#303330}
  .tag-option.selected{background:#2b2e2b}
  .option-grip{color:#626862;font-size:10px}
  .option-pill{
    display:inline-flex;align-items:center;padding:4px 7px;border-radius:5px;
    background:color-mix(in srgb,var(--tag) 30%,#282a28);border:1px solid color-mix(in srgb,var(--tag) 42%,#383a38);
    font-weight:700
  }
  .option-check{margin-left:auto;color:#a9aea8}
  .color-cycle{
    width:18px;height:18px;border-radius:50%;border:2px solid #555;background:var(--tag);margin-left:auto;cursor:pointer;padding:0
  }
  .new-tag-row{
    display:flex;align-items:center;gap:8px;padding:8px 7px;border-top:1px solid #373a37;margin-top:5px;cursor:pointer;font-size:12px
  }
  .new-tag-row:hover{background:#303330;border-radius:7px}
  .folder-button{
    border:1px solid #343834;background:#1f211f;border-radius:8px;padding:7px 9px;cursor:pointer;font-size:12px
  }
  .folder-option{padding:8px 9px;border-radius:7px;cursor:pointer;font-size:12px;display:flex;gap:8px;align-items:center}
  .folder-option:hover,.folder-option.selected{background:#303330}
  .folder-count{margin-left:auto;color:#727872;font-size:10px}

  .main-images{margin-bottom:22px}
  .section-line{display:flex;align-items:center;gap:10px;margin-bottom:10px}
  .section-line strong{font-size:13px}
  .section-line small{color:#717771;font-size:10px}
  .image-strip{display:flex;gap:9px;flex-wrap:wrap}
  .main-image-card{
    width:112px;height:90px;border:1px solid #343834;border-radius:10px;overflow:hidden;position:relative;
    background:linear-gradient(145deg,var(--a,#343834),var(--b,#171817));display:grid;place-items:center;font-size:30px
  }
  .main-image-card .caption{
    position:absolute;left:5px;right:5px;bottom:5px;background:rgba(0,0,0,.62);border-radius:5px;
    padding:3px 5px;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis
  }
  .main-image-card .remove-img{
    position:absolute;right:5px;top:5px;width:22px;height:22px;border:0;border-radius:6px;background:rgba(0,0,0,.65);cursor:pointer
  }
  .add-main-image{
    width:112px;height:90px;border:1px dashed #3b403b;border-radius:10px;background:#191b19;color:#767c76;cursor:pointer
  }
  .add-main-image:hover{border-color:#596159;color:#d4d8d3}

  .doc-section{border-top:1px solid #2d302d;padding-top:18px}
  .doc-head{display:flex;align-items:center;gap:7px;margin-bottom:9px}
  .doc-head strong{font-size:13px}
  .doc-actions{margin-left:auto;display:flex;gap:5px}
  .doc-btn{
