    if(typeof t==="object"&&t?.name)return {name:t.name,color:t.color||findCatalogColor(catalogKey,t.name)||TAG_PALETTE[i%TAG_PALETTE.length]};
    return {name:String(t),color:findCatalogColor(catalogKey,String(t))||TAG_PALETTE[i%TAG_PALETTE.length]};
  }).filter(t=>t.name.trim());
