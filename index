    if(/^::(?!:).+/.test(line)||/::$/.test(line))return `<span class="syn-fold">${inlineColorV5(esc)}</span>`;
    if(/^####\s/.test(line))return `<span class="syn-h4">${esc}</span>`;
    if(/^###\s/.test(line))return `<span class="syn-h3">${esc}</span>`;
    if(/^##\s/.test(line))return `<span class="syn-h2">${esc}</span>`;
    if(/^#\s/.test(line))return `<span class="syn-h1">${esc}</span>`;
    if(/^>\s?/.test(line))return `<span class="syn-quote">${inlineColorV5(esc)}</span>`;
