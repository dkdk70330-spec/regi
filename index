function renderDocPreviewV5(text){
  const lines=text.split("\n"),out=[];let i=0,codeId=0;
  while(i<lines.length){
    const line=lines[i];
    if(/^```/.test(line)){
      const lang=line.slice(3).trim()||"code",buf=[];i++;
      while(i<lines.length&&!/^```/.test(lines[i])){buf.push(lines[i]);i++}
      i++;
      const code=buf.join("\n");
      out.push(`<div class="preview-code"><div class="preview-code-head">${escapeHtml(lang)}<button data-copy-preview="${encodeURIComponent(code)}">복사</button></div><pre>${escapeHtml(code)}</pre></div>`);
      continue;
    }
    if(/^::(?!:).+/.test(line)){
      const title=line.replace(/^::/,"").trim()||"접기",buf=[];i++;
      while(i<lines.length){
        const current=lines[i];
        if(current==="::"){i++;break}
        if(/::$/.test(current)){
          const body=current.slice(0,-2);
          if(body)buf.push(body);
          i++;
          break;
        }
        buf.push(current);i++;
      }
      out.push(`<details class="preview-fold"><summary>${escapeHtml(title)}</summary><div class="fold-inner">${renderSimpleLinesV5(buf)}</div></details>`);
      continue;
    }
    const bm=line.match(/^\{\{bookmark:(https?:\/\/.+)\}\}$/);
    if(bm){
      const url=bm[1],title=autoLinkTitle(url),letter=title.slice(0,1).toUpperCase();
      out.push(`<a class="preview-bookmark" href="${attr(url)}" target="_blank" rel="noopener"><div class="bookmark-copy"><b>${escapeHtml(title)}</b><small>${escapeHtml(url)}</small></div><div class="bookmark-art">${escapeHtml(letter)}</div></a>`);i++;continue;
    }
    const mn=line.match(/^\[\[(https?:\/\/.+)\]\]$/);
    if(mn){out.push(`<a class="preview-mention" href="${attr(mn[1])}" target="_blank" rel="noopener">↗ ${escapeHtml(autoLinkTitle(mn[1]))}</a>`);i++;continue}
    out.push(renderLineV5(line));i++;
  }
  return out.join("");
}
function renderSimpleLinesV5(lines){return lines.map(renderLineV5).join("")}
function renderLineV5(line){
