function normalizeProjectV5(p){
  if(!p.createdAt)p.createdAt=p.date?`${p.date} 00:00`:stampNow();
  if(!p.updatedAt)p.updatedAt=p.createdAt;
  if(!p.genreTags)p.genreTags=[];
  p.genreTags=normalizeTagObjects(p.genreTags,"genreTags");
  if(!p.actualTags)p.actualTags=normalizeTagObjects(p.tags||[],"actualTags");
  else p.actualTags=normalizeTagObjects(p.actualTags,"actualTags");
  if(!p.platformTags){
    const ps=(p.platform||"").split(",").map(x=>x.trim()).filter(Boolean);
    p.platformTags=normalizeTagObjects(ps,"platformTags");
  }else p.platformTags=normalizeTagObjects(p.platformTags,"platformTags");
  [...p.genreTags,...p.actualTags,...p.platformTags].forEach(t=>{});
  p.genreTags.forEach(t=>ensureCatalogOption("genreTags",t.name,t.color));
  p.actualTags.forEach(t=>ensureCatalogOption("actualTags",t.name,t.color));
  p.platformTags.forEach(t=>ensureCatalogOption("platformTags",t.name,t.color));

  if(typeof p.content!=="string"){
    const parts=[];
    if(p.story)parts.push(p.story);
    if(p.world)parts.push(`:::접기 세계관\n${p.world}\n:::`);
    if(p.commands)parts.push(`:::접기 명령어\n${p.commands}\n:::`);
    if(p.html)parts.push("```html\n"+p.html+"\n```");
    p.content=parts.join("\n\n");
  }
  if(!Array.isArray(p.mainImages))p.mainImages=[];
  if(!Array.isArray(p.bodyImages))p.bodyImages=[];
  if(typeof p.releaseDate!=="string")p.releaseDate="";
  if(typeof p.assetFolder!=="string")p.assetFolder="";
  return p;
}
