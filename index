function renderCalendar(){
 qs("#calendarTitle").textContent=`${calendarYear}년 ${calendarMonth}월`;
 if(calendarViewMode==="release"){
   renderReleaseCalendar();
   return;
 }
 renderMonthTodos();
 const names=["일","월","화","수","목","금","토"];
 qs("#calendarWeekdays").innerHTML=names.map(n=>`<div class="calendar-weekday">${n}</div>`).join("");

 const weeks=monthWeeksCal(calendarYear,calendarMonth);
 const today=dateKeyCal(new Date());
 const root=qs("#calendar");
 root.innerHTML="";

 weeks.forEach(week=>{
   const weekStart=week[0],weekEnd=week[6];
   const segments=[];
   calendarEvents.forEach(ev=>{
     if(!ev.start)return;
     const evStart=parseCalDate(ev.start);
     const evEnd=parseCalDate(ev.end||ev.start);
     if(evEnd<weekStart || evStart>weekEnd)return;
     const segStart=maxCalDate(evStart,weekStart);
     const segEnd=minCalDate(evEnd,weekEnd);
     const startCol=Math.round((segStart-weekStart)/86400000)+1;
     const endCol=Math.round((segEnd-weekStart)/86400000)+1;
     segments.push({
       ev,
       startCol,
       endCol,
       isStart:dateKeyCal(segStart)===dateKeyCal(evStart),
       isEnd:dateKeyCal(segEnd)===dateKeyCal(evEnd)
     });
   });
   segments.sort((a,b)=>a.startCol-b.startCol || b.endCol-a.endCol);
   const laid=assignCalendarLanes(segments);
   const laneCount=Math.max(1,...laid.map(s=>s.lane+1));

   const weekEl=document.createElement("div");
   weekEl.className="cal-week";
   weekEl.style.setProperty("--lanes",laneCount);

   week.forEach((d,i)=>{
     const key=dateKeyCal(d);
     const cell=document.createElement("div");
     cell.className="cal-day-bg"+(d.getMonth()!==calendarMonth-1?" outside":"")+(key===today?" today":"");
     cell.style.gridColumn=String(i+1);
     cell.innerHTML=`<span class="cal-date">${d.getDate()}</span>`;
     cell.onclick=()=>openCalendarEvent(null,key);
     weekEl.appendChild(cell);
   });

   laid.forEach(seg=>{
     const ev=seg.ev,p=presetForEvent(ev);
     const bar=document.createElement("div");
     const single=seg.startCol===seg.endCol && seg.isStart && seg.isEnd;
     bar.className=`cal-event-bar${seg.isStart?" segment-start":""}${seg.isEnd?" segment-end":""}${single?" single":""}`;
     bar.style.gridColumn=`${seg.startCol} / ${seg.endCol+1}`;
     bar.style.gridRow=String(seg.lane+2);
     bar.style.cssText+=calendarBarStyle(p);
