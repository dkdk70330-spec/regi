function inlineColorV5(s){
  const stash=[],put=(cls,v)=>{const k=`@@V5${stash.length}@@`;stash.push(`<span class="${cls}">${v}</span>`);return k};
  s=s.replace(/\{\{bookmark:https?:\/\/.*?\}\}/g,m=>put("syn-link",m));
  s=s.replace(/\[\[https?:\/\/.*?\]\]/g,m=>put("syn-link",m));
  s=s.replace(/\{\{user\}\}/gi,m=>put("syn-user",m));
  s=s.replace(/\{\{char\}\}/gi,m=>put("syn-char",m));
  s=s.replace(/\{\{[^{}\n]+\}\}/g,m=>put("syn-curly",m));
  s=s.replace(/\[[^\]\n]+\]/g,m=>put("syn-bracket",m));
  s=s.replace(/\|[^|\n]+\|/g,m=>put("syn-pipe",m));
  s=s.replace(/\*\*[^*\n]+\*\*/g,m=>put("syn-bold",m));
  s=s.replace(/\*[^*\n]+\*/g,m=>put("syn-italic",m));
  stash.forEach((v,i)=>s=s.replace(`@@V5${i}@@`,v));return s;
}
